{
  "regions": ["bom1"],
  "ignoreCommand": "[ \"$VERCEL_ENV\" != production ] && ! git log -1 --format=%B | grep -qF \"[preview]\"",
  "crons": [
    {
      "path": "/api/cron/media-scan",
      "schedule": "30 18 * * *"
    },
    {
      "path": "/api/cron/batch-reminders",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/daily-digest",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/social-posts",
      "schedule": "0 0 * * *"
    }
  ]
}
