// COSS — Prisma schema
// Run:
//   npx prisma generate           (after any schema change)
//   npx prisma migrate dev        (apply during development)
//   npx prisma studio             (visual DB editor)
//
// DATABASE_URL is read from .env.local (or .env) — set it before running.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Lead captured from public-site forms. status: new -> contacted -> enrolled | lost.
model Lead {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  course    String?
  branch    String
  formType  String
  status    String   @default("new")
  message   String?
  createdAt DateTime @default(now())

  activities LeadActivity[]

  @@index([createdAt])
  @@index([status])
  @@index([branch])
}

/// Corporate-training leads with company-level info.
model CorporateLead {
  id             String   @id @default(cuid())
  companyName    String
  contactPerson  String
  phone          String
  email          String
  trainingDomain String
  employeeCount  String
  status         String   @default("new")
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([status])
}

/// Per-page SEO overrides. One row per public page slug.
model PageSeo {
  id              String   @id @default(cuid())
  pageSlug        String   @unique
  pageTitle       String
  metaTitle       String?
  metaDescription String?
  ogTitle         String?
  ogDescription   String?
  ogImage         String?
  canonicalUrl    String?
  noIndex         Boolean  @default(false)
  noFollow        Boolean  @default(false)
  schemaMarkup    String?
  focusKeyword    String?
  keywords        String?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
}

/// Site-wide SEO knobs. Singleton.
model SeoSettings {
  id                    String   @id @default(cuid())
  googleAnalyticsId     String?
  googleSearchConsoleId String?
  defaultOgImage        String?
  siteTitle             String?
  twitterHandle         String?
  robotsTxt             String?
  updatedAt             DateTime @updatedAt
}

/// Announcement bar settings. Singleton.
/// Spec name -> DB column: isEnabled->enabled, announcementText->text, backgroundColor->bgColor
model AnnouncementBar {
  id        String   @id @default(cuid())
  enabled   Boolean  @default(true)
  text      String   @default("New batch starting soon - Limited seats available!")
  ctaLabel  String   @default("Enroll Now")
  ctaUrl    String   @default("/enroll-now-with-coss/")
  bgColor   String   @default("#0f766e")
  textColor String   @default("#ffffff")
  updatedAt DateTime @updatedAt
}

/// Admin users with role-based access. SUPER_ADMIN is the only role that can
/// manage this table. Env-var admin (ADMIN_EMAIL/ADMIN_PASSWORD) is a separate
/// fallback and does not appear here.
enum AdminRole {
  SUPER_ADMIN
  ADMISSIONS_SALES
  SUPPORT_HELPDESK
}

model AdminUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(ADMISSIONS_SALES)
  permissions  String[]
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([email])
  @@index([role])
}

/// Category grouping for courses. isLegacy=true rows have locked slugs.
model CourseCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  color       String?
  sortOrder   Int      @default(0)
  isLegacy    Boolean  @default(false)
  status      String   @default("published")
  seoTitle    String?
  seoDesc     String?
  courses     Course[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Course listing managed from the admin panel.
model Course {
  id            String          @id @default(cuid())
  title         String
  slug          String          @unique
  description   String
  excerpt       String
  category      String
  duration      String
  mode          String
  level         String
  price         Float?
  originalPrice Float?
  badge         String?
  thumbnail     String?
  syllabus      Json            @default("[]")
  highlights    String[]
  tools         String[]
  status        String          @default("draft")
  featured      Boolean         @default(false)
  sortOrder     Int             @default(0)
  seoTitle      String?
  seoDesc       String?
  categoryId    String?
  categorySlug  String?
  urlType       String          @default("legacy")
  courseCategory CourseCategory? @relation(fields: [categoryId], references: [id])
  batches       Batch[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([status])
  @@index([category])
  @@index([slug])
  @@index([categorySlug])
}

/// Blog post managed from the admin panel.
model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String
  content     String    @db.Text
  category    String
  tags        String[]
  thumbnail   String?
  author      String    @default("COSS Team")
  authorRole  String    @default("Editorial Team")
  readTime    String?
  status      String    @default("draft")
  featured    Boolean   @default(false)
  views       Int       @default(0)
  seoTitle    String?
  seoDesc     String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([category])
  @@index([slug])
}

model Job {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  company         String
  companyLogo     String?
  location        String
  type            String
  mode            String
  category        String
  experience      String
  salary          String?
  description     String    @db.Text
  skills          String[]
  applyUrl        String?
  relatedCourseId String?
  status          String    @default("active")
  featured        Boolean   @default(false)
  expiresAt       DateTime?
  postedAt        DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([category])
  @@index([slug])
}

model Batch {
  id             String    @id @default(cuid())
  courseId       String
  course         Course    @relation(fields: [courseId], references: [id])
  batchName      String
  mode           String
  centre         String?
  startDate      DateTime
  endDate        DateTime?
  schedule       String
  totalSeats     Int?
  seatsAvailable Int?
  trainer        String?
  price          Float?
  status         String    @default("upcoming")
  featured       Boolean   @default(false)
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([courseId])
}

/// Timeline entries against a Lead. Cascades on Lead delete.
model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  action    String
  note      String
  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([createdAt])
}

/// Singleton controlling all editable homepage content. id is always "main".
model HomepageSettings {
  id                     String   @id @default("main")

  // Hero
  heroHeadline           String   @default("Launch Your IT Career in Hyderabad")
  heroSubtext            String   @default("Hands-on training at Dilsukhnagar & Ameerpet. Real projects, certified trainers, 100% placement support.")
  heroCTAPrimaryText     String   @default("Enroll Now")
  heroCTAPrimaryUrl      String   @default("/enroll-now-with-coss")
  heroCTASecondaryText   String   @default("Free Demo Class")
  heroCTASecondaryUrl    String   @default("/free-demo-class")

  // Stats
  stat1Value             String   @default("15+")
  stat1Label             String   @default("Years Experience")
  stat2Value             String   @default("5000+")
  stat2Label             String   @default("Students Placed")
  stat3Value             String   @default("30+")
  stat3Label             String   @default("Courses")
  stat4Value             String   @default("200+")
  stat4Label             String   @default("Hiring Partners")

  // Announcement bar (supplemental — primary bar managed via /admin/topbar)
  announcementEnabled    Boolean  @default(true)
  announcementText       String   @default("Next batch starts 1 Jul 2026 — Limited seats available!")
  announcementUrl        String   @default("/enroll-now-with-coss")
  announcementBgColor    String   @default("#f97316")

  // Featured courses
  featuredCourseIds      String[] @default([])
  featuredSectionTitle   String   @default("Popular Courses")
  featuredSectionSubtext String   @default("Industry-relevant curriculum built for the Hyderabad job market.")

  // Section toggles
  showFeaturedCourses    Boolean  @default(true)
  showTestimonials       Boolean  @default(true)
  showHiringPartners     Boolean  @default(true)
  showStats              Boolean  @default(true)

  updatedAt              DateTime @updatedAt
}

model BranchSettings {
  id              String   @id @default(cuid())
  branchKey       String   @unique
  branchName      String
  addressLine1    String
  addressLine2    String   @default("")
  city            String   @default("Hyderabad")
  state           String   @default("Telangana")
  pincode         String
  phone           String
  email           String   @default("info@cosscloudsol.com")
  latitude        Float
  longitude       Float
  workingHoursOpen  String @default("09:00")
  workingHoursClose String @default("19:00")
  workingDays     String   @default("Monday-Saturday")
  mapEmbedUrl     String   @default("")
  serviceAreas    String   @default("[]")
  aggregateRating Float    @default(4.8)
  reviewCount     Int      @default(0)
  schemaEnabled   Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SiteSettings {
  id              String    @id @default(cuid())
  ogImageUrl      String?
  logoUrl         String?
  logoLightUrl    String?
  faviconUrl      String?
  appleTouchUrl   String?
  courseOgDefault String?
  updatedAt       DateTime? @updatedAt
  createdAt       DateTime  @default(now())
}

model MediaScanResult {
  id            String   @id @default(cuid())
  scannedAt     DateTime @default(now())
  totalImages   Int      @default(0)
  brokenCount   Int      @default(0)
  slowCount     Int      @default(0)
  redirectCount Int      @default(0)
  results       Json     @default("[]")
  createdAt     DateTime @default(now())
}
